<UserControl x:Class="IDOLSelfCheckout.UserControls.ucVirginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IDOLSelfCheckout.UserControls"
             mc:Ignorable="d" 
             d:MinHeight="100" d:MinWidth="100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Background="White" Grid.Column="0" Grid.Row="0">
            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label FontSize="28" FontWeight="Normal" FontStretch="Normal">Select Item</Label>
            </DockPanel>
        </Border>

        <Border Background="White" Grid.Column="0" Grid.Row="1">
            <Grid>
                <Grid.Resources >
                    <Style TargetType="Border" >
                        <Setter Property="Padding" Value="5,5,5,5" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Background="White" Grid.Column="0" Grid.Row="0">

                    <Button x:Name="btn_virgin_item1" Command="{Binding ButtonClickCommand}" CommandParameter="423432432432" Click="btn_virgin_item1_Click"   >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom" >VIRGIN 30 SAR</Label>
                            <Image  Source="C:/IDOL/images/icons/scovirginlogo.png"   />

                        </DockPanel>

                    </Button>

                </Border>

                <Border Background="White" Grid.Column="1" Grid.Row="0">

                    <Button Name="btn_virgin_item2" Click="btn_virgin_item2_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">VIRGIN 55 SAR</Label>
                            <Image  Source="C:/IDOL/images/icons/scovirginlogo.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="2" Grid.Row="0">

                    <Button Name="btn_virgin_item3" Click="btn_virgin_item3_Click"    >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">VIRGIN 110 SAR</Label>
                            <Image  Source="C:/IDOL/images/icons/scovirginlogo.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="0" Grid.Row="1">

                    <Button Name="btn_virgin_item4" Click="btn_virgin_item4_Click"   >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">VIRGIN 525 SAR</Label>
                            <Image  Source="C:/IDOL/images/icons/scovirginlogo.png"   />

                        </DockPanel>
                    </Button>

                </Border>


            </Grid>
        </Border>

        <Border Background="LightGray" Grid.Column="0" Grid.Row="4">
            <Button x:Name="btn_back" FontSize="36" FontWeight="Bold" Foreground="White" Click="btn_back_Click" >
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FFB81D1D" Offset="0.763"/>
                        <GradientStop Color="#FF909090" Offset="0.018"/>
                    </LinearGradientBrush>
                </Button.Background> BACK

            </Button>

        </Border>

    </Grid>
</UserControl>

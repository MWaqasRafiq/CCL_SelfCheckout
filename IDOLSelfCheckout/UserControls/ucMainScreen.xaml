<UserControl x:Class="IDOLSelfCheckout.UserControls.ucMainScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IDOLSelfCheckout.UserControls"
             Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="main_sco" ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>
            <Border Background="White" Grid.Column="0" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Border Background="White" Grid.Column="0" Grid.Row="0">
                        <DockPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Label x:Name="item_info" FontSize="23" FontWeight="Normal" FontStretch="Normal">Scan Item</Label>
                        </DockPanel>
                    </Border>
                    <Border Background="White" Grid.Column="1" Grid.Row="0">
                        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Label x:Name="transactoin_details" FontSize="16" FontWeight="Normal" FontStretch="Normal"/>
                        </DockPanel>
                    </Border>
                    <Border Background="White" Grid.Column="2" Grid.Row="0">
                        <Button Click="btn_help_Click" Name="btn_help" BorderThickness="0" Padding="-4">
                            <Image Source="C:/IDOL/images/help5.jpg" Stretch="Fill"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>
            <Border Background="Red" Grid.Column="0" Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Border Background="Azure" Grid.Column="0" Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="113*"/>
                                <ColumnDefinition Width="53*"/>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="113*"/>
                                <ColumnDefinition Width="113*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Border Background="Azure" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5">
                                <Grid>
                                    <DataGrid x:Name="item_list" AutoGenerateColumns="False" CanUserResizeColumns="False"
                            GridLinesVisibility="None" ItemsSource="{Binding items}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Width="250" Binding="{Binding Name}">
                                                <DataGridColumn.HeaderStyle>
                                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                                        <Setter Property="Control.FontSize" Value="20"/>
                                                        <Setter Property="Control.HorizontalContentAlignment" Value="Left"/>
                                                    </Style>
                                                </DataGridColumn.HeaderStyle>
                                                <DataGridBoundColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="TextBlock.FontSize" Value="20"/>
                                                        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Left"/>
                                                        <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridBoundColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Qty" Width="100" Binding="{Binding Qty}">
                                                <DataGridColumn.HeaderStyle>
                                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                                        <Setter Property="Control.FontSize" Value="20"/>
                                                        <Setter Property="Control.HorizontalContentAlignment" Value="Right"/>
                                                        <Setter Property="Control.FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridColumn.HeaderStyle>
                                                <DataGridBoundColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="TextBlock.FontSize" Value="20"/>
                                                        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridBoundColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Price" Width="100" Binding="{Binding Price}">
                                                <DataGridColumn.HeaderStyle>
                                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                                        <Setter Property="Control.FontSize" Value="20"/>
                                                        <Setter Property="Control.HorizontalContentAlignment" Value="Right"/>
                                                        <Setter Property="Control.FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridColumn.HeaderStyle>
                                                <DataGridBoundColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="TextBlock.FontSize" Value="20"/>
                                                        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridBoundColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <Border Background="White" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5">
                                <DockPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Label x:Name="transactoin_vat" FontSize="30" FontWeight="Bold" FontStretch="Normal">VAT:</Label>
                                </DockPanel>
                            </Border>
                            <Border Background="White" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="6">
                                <DockPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Label x:Name="transactoin_total" FontSize="30" FontWeight="Bold" FontStretch="Normal">TOTAL:</Label>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="Aqua" Grid.Column="1" Grid.Row="0">
                        <Grid x:Name="Item_sco"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="IDOLSelfCheckout.UserControls.ucAsistantScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IDOLSelfCheckout.UserControls"
             mc:Ignorable="d" 
             d:MinHeight="100" d:MinWidth="100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Background="White" Grid.Column="0" Grid.Row="0">
            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!--<Label x:Name="messageTxt" FontSize="12" FontWeight="Normal" FontStretch="Normal">Assistant Screen</Label>-->
                <!--<TextBlock  x:Name="messageTxt" TextWrapping="WrapWithOverflow" ScrollViewer.VerticalScrollBarVisibility="Auto"  ></TextBlock>-->
                <TextBox x:Name="messageTxt" TextWrapping="Wrap"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.CanContentScroll="True">Message
                </TextBox>

            </DockPanel>
        </Border>

        <Border Background="White" Grid.Column="0" Grid.Row="1">
            <Grid>
                <Grid.Resources >
                    <Style TargetType="Border" >
                        <Setter Property="Padding" Value="5,5,5,5" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Background="White" Grid.Column="0" Grid.Row="0">

                    <Button x:Name="btn_bakery_item1" Background="White" Command="{Binding ButtonClickCommand}" CommandParameter="423432432432"   >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom" >VOID</Label>
                            <Image  Source="C:/IDOL/images/icons/voiddisc.png"   />

                        </DockPanel>

                    </Button>

                </Border>

                <Border Background="White" Grid.Column="1" Grid.Row="0">

                    <Button Name="btn_assistant_reconsulation" Background="White" Click="btn_assistant_reconsulation_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">RECONSULATION</Label>
                            <Image  Source="C:/IDOL/images/icons/reset.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="2" Grid.Row="0">

                    <Button Name="btn_new_transaction"  Background="White" Click="btn_new_transaction_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">NEW TRANSACTION</Label>
                            <Image  Source="C:/IDOL/images/icons/refresh.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="0" Grid.Row="1">

                    <Button Name="btn_donation_item4"  Background="White"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">SETTINGS</Label>
                            <Image  Source="C:/IDOL/images/icons/nosale.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="1" Grid.Row="1">

                    <Button Name="btn_closed_screen"  Background="White" Click="btn_closed_screen_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">CLOSED</Label>
                            <Image  Source="C:/IDOL/images/icons/reset.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="2" Grid.Row="1">

                    <Button Name="btn_reprint"  Background="White" Click="btn_reprint_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">REPRINT</Label>
                            <Image  Source="C:/IDOL/images/icons/reset.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="0" Grid.Row="2">

                    <Button Name="btn_donation_item7"  Background="White"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">RESET</Label>
                            <Image  Source="C:/IDOL/images/icons/reset.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="1" Grid.Row="2">

                    <Button Name="btn_led"  Background="White" Click="btn_led_Click"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">LED TEST</Label>
                            <Image  Source="C:/IDOL/images/icons/enter.png"   />

                        </DockPanel>
                    </Button>

                </Border>

                <Border Background="White" Grid.Column="2" Grid.Row="2">

                    <Button Name="btn_donation_item9"  Background="White"  >
                        <DockPanel LastChildFill="True">
                            <Label HorizontalContentAlignment="Center" DockPanel.Dock="Bottom">SETTING</Label>
                            <Image  Source="C:/IDOL/images/icons/reset.png"   />

                        </DockPanel>
                    </Button>

                </Border>


            </Grid>
        </Border>

        <Border Background="LightGray" Grid.Column="0" Grid.Row="2">
            <Button x:Name="btn_back" FontSize="36" FontWeight="Bold" Foreground="White" Click="btn_back_Click" >
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FFB81D1D" Offset="0.763"/>
                        <GradientStop Color="#FF909090" Offset="0.018"/>
                    </LinearGradientBrush>
                </Button.Background> BACK

            </Button>

        </Border>


    </Grid>
</UserControl>

<UserControl x:Class="IDOLSelfCheckout.UserControls.ucCreditCardScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IDOLSelfCheckout.UserControls"
             mc:Ignorable="d" 
             d:MinHeight="100" d:MinWidth="100" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Border Background="White" Grid.Column="0" Grid.Row="0">
            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label x:Name="PinpadInfo" FontSize="28" FontWeight="Normal" FontStretch="Normal">Please follow EFT instractions..</Label>
            </DockPanel>
        </Border>

        <Border Background="Blue" Grid.Column="0" Grid.Row="1">

            <Button Name="btn_cardpayment_sco"  >
                <Image Source="C:/IDOL/images/scoeftpayment.png" Stretch="Fill" />
            </Button>
        </Border>
    </Grid>
</UserControl>
